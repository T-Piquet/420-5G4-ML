// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "420-5G4 - LLM Agentique & GUI",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {
			"password": "vscode"
		}
	},
	"forwardPorts": [6080],
	"portsAttributes": {
		"6080": {
			"label": "CustomTkinter GUI Desktop (noVNC)",
			"onAutoForward": "openBrowser"
		}
	},
	"runArgs": [
		"--shm-size=1g"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"ms-python.python",
				"Continue.continue"
			]
		}
	},
	"postCreateCommand": "which opencode || (curl -fsSL https://opencode.ai/v2/install | bash && sudo cp ~/.opencode/bin/opencode /usr/local/bin/opencode 2>/dev/null || true)"
}
