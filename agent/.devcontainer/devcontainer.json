// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},
	
// Monter le socket X11 hôte dans le conteneur
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  
  // Transmettre la variable d'affichage
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  
  // Donner l'accès au serveur X11 (si nécessaire sur certains systèmes)
  "runArgs": [
    "--net=host"
  ],

  // Créer l'environnement Python de l'interface graphique (partie 4).
  // Le test -f rend la commande valable que le workspace soit la racine du
  // dépôt ou le dossier agent/.
  "postCreateCommand": "if [ -f agent/requirements.txt ]; then cd agent; fi; python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",

}
